    {
        "id": "prep_final",
        "type": "function",
        "z": "svv_bachelor_final_fix",
        "name": "Klargjør API",
        "func": "if (!msg.payload || msg.payload.length < 2) {\n    return null;\n}\n\nconst skilt = msg.payload.toString().replace(/\\s+/g, '').toUpperCase();\nconst apiKey = global.get(\"SVV_API_KEY\");\n\nif (!apiKey) {\n    node.error(\"FEIL: API-nøkkelen 'SVV_API_KEY' ble ikke funnet i global context!\");\n    return null;\n}\n\nmsg.skilt = skilt;\n\nmsg.url = \"https://akfell-datautlevering.atlas.vegvesen.no/enkeltoppslag/kjoretoydata?kjennemerke=\" + skilt;\n\nmsg.headers = {\n    \"SVV-Authorization\": \"Apikey \" + apiKey.trim(),\n    \"Accept\": \"application/json\",\n    \"User-Agent\": \"Node-RED-Bachelor-Project\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 40,
        "wires": [
            [
                "http_final"
            ]
        ]
    },
    {
        "id": "http_final",
        "type": "http request",
        "z": "svv_bachelor_final_fix",
        "name": "SVV_API_Request",
        "method": "GET",
        "ret": "txt",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 810,
        "y": 40,
        "wires": [
            [
                "logic_final"
            ]
        ]
    },
    {
        "id": "logic_final",
        "type": "function",
        "z": "svv_bachelor_final_fix",
        "name": "DIN LOGIKK (DeepFind)",
        "func": "// SVV sender ofte payload som string → parse til JSON først\nlet payload = msg.payload;\nif (typeof payload === \"string\") {\n    try {\n        payload = JSON.parse(payload);\n    } catch (e) {\n        return { payload: { found: false, error: \"Ugyldig JSON fra API\" } };\n    }\n}\n\n// hent første bil i lista (det er alltid den vi jobber med)\nconst bil = payload?.kjoretoydataListe?.[0];\nif (!bil) {\n    return { payload: { found: false, error: \"Fant ikke bil i responsen\" } };\n}\n\n// enkel helper: finner nøkkel dypt i objekt (brukes kun der vi ikke har fast sti)\nfunction deepFind(obj, key) {\n    let results = [];\n    if (!obj || typeof obj !== \"object\") return results;\n\n    if (obj[key] !== undefined && obj[key] !== null && obj[key] !== \"\") {\n        results.push(obj[key]);\n    }\n\n    for (let k in obj) {\n        results.push(...deepFind(obj[k], key));\n    }\n\n    return results;\n}\n\n// plukker ut verdi fra rare SVV-objekter\nfunction pick(v) {\n    if (Array.isArray(v)) return pick(v[0]);\n    if (v && typeof v === \"object\") return v.verdi || v.navn || v.tekst || \"\";\n    return v || \"\";\n}\n\n// formatter dato til norsk visning\nfunction formatDato(d) {\n    if (!d || String(d).length < 10) return \"Ikke oppgitt\";\n    const [y, m, day] = String(d).slice(0, 10).split(\"-\");\n    return `${day}.${m}.${y}`;\n}\n\n// ---- HER ER DET VIKTIGE ----\n// vi bruker EKSAKT sti fra SVV (ingen deepFind her lenger)\n\nconst merkeRaw =\n    bil?.godkjenning?.tekniskGodkjenning?.tekniskeData?.generelt?.merke?.[0]?.merke || \"\";\n\nconst modellRaw =\n    bil?.godkjenning?.tekniskGodkjenning?.tekniskeData?.generelt?.handelsbetegnelse?.[0] || \"\";\n\n// fallback (bare i tilfelle SVV endrer struktur)\nconst merke = merkeRaw ? merkeRaw.toUpperCase() : \"UKJENT\";\nconst modell = modellRaw ? modellRaw.toUpperCase() : \"\";\n\n// datoer (her er deepFind fortsatt greit fordi felt varierer)\nconst regRaw = pick(deepFind(bil, \"registrertForstegangNorgeDato\"));\n\nconst euCands = [\n    ...deepFind(bil, \"nesteFristForGodkjentPeriodiskKjoretoykontroll\"),\n    ...deepFind(bil, \"kontrollfrist\"),\n    ...deepFind(bil, \"nesteFrist\"),\n    ...deepFind(bil, \"frist\"),\n    bil?.periodiskKjoretoykontroll?.kontrollfrist\n];\n\nconst euRaw = pick(euCands);\n\n// plate fra tidligere node\nconst scannedPlate = String(msg.skilt || \"\")\n    .replace(/\\s+/g, \"\")\n    .toUpperCase();\n\n// hent reservasjoner\nlet reserved = flow.get(\"reservedPlates\") || [];\nreserved = reserved.map(item => {\n    const value = (item && typeof item === \"object\") ? item.plate : item;\n    return String(value || \"\").replace(/\\s+/g, \"\").toUpperCase();\n});\n\n// sjekk adgang\nconst adgangGodkjent = reserved.includes(scannedPlate);\n\n// bygg payload til dashboard\nmsg.payload = {\n    found: true,\n    skilt: scannedPlate,\n    merke: merke,\n    modell: modell,\n    registrert: formatDato(regRaw),\n    eu_frist: formatDato(euRaw),\n    eu_farge: (euRaw && new Date(euRaw) < new Date()) ? \"#be123c\" : \"#15803d\",\n    adgang_godkjent: adgangGodkjent,\n    adgang_tekst: adgangGodkjent ? \"Godkjent\" : \"Avslått\",\n    adgang_farge: adgangGodkjent ? \"#15803d\" : \"#be123c\"\n};\n\n// ---- CACHE TIL HISTORIKK ----\n// lagrer merke/modell per skilt så historikk-lista slipper API-kall\n\nlet cache = flow.get(\"vehicleCache\") || {};\n\nif (scannedPlate) {\n    cache[scannedPlate] = {\n        merke: merke,\n        modell: modell\n    };\n\n    flow.set(\"vehicleCache\", cache);\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1030,
        "y": 40,
        "wires": [
            [
                "d1d8852d1ba39da1"
            ]
        ]
    },
    {
        "id": "design_final",
        "type": "ui-template",
        "z": "svv_bachelor_final_fix",
        "group": "ui_group_final",
        "page": "",
        "ui": "",
        "name": "Design",
        "order": 2,
        "width": 6,
        "height": 4,
        "format": "<div style=\"font-family: Inter, Arial, sans-serif;\">\n\n  <div v-if=\"msg.payload && msg.payload.found\" style=\"background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);\n              padding: 16px;\n              border-radius: 18px;\n              border: 1px solid #dbe7f3;\n              box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);\n              overflow: hidden;\">\n\n    <div style=\"display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:14px;\">\n      <div>\n        <div\n          style=\"font-size:11px; color:#64748b; font-weight:700; text-transform:uppercase; letter-spacing:1.1px; margin-bottom:4px;\">\n          Kjøretøyoppslag\n        </div>\n\n        <div style=\"font-size:28px; font-weight:900; color:#0f172a; line-height:1; margin-bottom:6px;\">\n          {{ msg.payload.merke }}\n          <span style=\"font-weight:400; color:#475569;\">{{ msg.payload.modell }}</span>\n        </div>\n\n        <div style=\"font-size:13px; color:#64748b;\">\n          Oppslag mot kjøretøydata\n        </div>\n      </div>\n\n      <div style=\"display:flex; flex-direction:column; gap:8px; align-items:flex-end;\">\n\n\n        <div :style=\"{\n              background: msg.payload.eu_farge === '#be123c' ? '#fff1f2' : '#f0fdf4',\n              color: msg.payload.eu_farge === '#be123c' ? '#be123c' : '#15803d',\n              border: msg.payload.eu_farge === '#be123c' ? '1px solid #fecdd3' : '1px solid #bbf7d0',\n              padding: '8px 12px',\n              borderRadius: '999px',\n              fontSize: '12px',\n              fontWeight: '800',\n              whiteSpace: 'nowrap'\n            }\">\n          {{ msg.payload.eu_farge === '#be123c' ? 'EU utløpt / må sjekkes' : 'EU gyldig' }}\n        </div>\n\n      </div>\n    </div>\n\n    <div style=\"display:grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap:10px;\">\n      <div style=\"background:#ffffff; padding:14px; border-radius:14px; border:1px solid #e2e8f0;\">\n        <div\n          style=\"font-size:10px; color:#64748b; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:6px;\">\n          Skannet skiltnummer\n        </div>\n        <div style=\"font-size:18px; font-weight:800; color:#0f172a;\">\n          {{ msg.payload.skilt }}\n        </div>\n      </div>\n\n      <div style=\"background:#ffffff; padding:14px; border-radius:14px; border:1px solid #e2e8f0;\">\n        <div\n          style=\"font-size:10px; color:#64748b; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:6px;\">\n          Første registrering\n        </div>\n        <div style=\"font-size:18px; font-weight:800; color:#0f172a;\">\n          {{ msg.payload.registrert }}\n        </div>\n      </div>\n\n      <div style=\"background:#ffffff; padding:14px; border-radius:14px; border:1px solid #e2e8f0;\">\n        <div\n          style=\"font-size:10px; color:#64748b; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:6px;\">\n          Neste EU-kontroll\n        </div>\n        <div :style=\"{\n              fontSize: '18px',\n              fontWeight: '800',\n              color: msg.payload.eu_farge || '#15803d'\n            }\">\n          {{ msg.payload.eu_frist }}\n        </div>\n      </div>\n\n      <div :style=\"{\n            background: msg.payload.adgang_godkjent ? '#f0fdf4' : '#fff1f2',\n            border: msg.payload.adgang_godkjent ? '1px solid #bbf7d0' : '1px solid #fecdd3',\n            padding: '14px',\n            borderRadius: '14px'\n          }\">\n        <div\n          style=\"font-size:10px; color:#64748b; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:6px;\">\n          Adgangsstatus\n        </div>\n        <div :style=\"{\n              fontSize: '18px',\n              fontWeight: '800',\n              color: msg.payload.adgang_farge\n            }\">\n          {{ msg.payload.adgang_tekst }}\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div v-else style=\"background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);\n              border: 1px dashed #cbd5e1;\n              border-radius: 18px;\n              padding: 22px 18px;\n              text-align: center;\n              box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);\">\n\n    <div style=\"font-size:36px; margin-bottom:8px;\">🚗</div>\n\n    <div style=\"font-size:18px; font-weight:800; color:#0f172a; margin-bottom:6px;\">\n      Venter på ny skanning\n    </div>\n\n    <div style=\"font-size:13px; color:#64748b; max-width:420px; margin:0 auto; line-height:1.5;\">\n      Kjøretøydata vises automatisk når en ny gyldig bildefil blir oppdaget.\n    </div>\n\n    <div v-if=\"msg.payload?.error\"\n      style=\"margin-top:12px; background:#fff1f2; color:#be123c; border:1px solid #fecdd3; padding:10px 12px; border-radius:12px; font-size:13px; font-weight:600;\">\n      {{ msg.payload.error }}\n    </div>\n  </div>\n\n</div>",
        "storeOutMessages": true,
        "passthru": true,
        "templateScope": "local",
