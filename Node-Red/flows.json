    {
        "id": "prep_final",
        "type": "function",
        "z": "svv_bachelor_final_fix",
        "name": "Klargjør API",
        "func": "// 1. Sjekk at vi har mottatt et skiltnummer fra dashboardet\nif (!msg.payload || msg.payload.length < 2) {\n    return null;\n}\n\n// 2. Hent API-nøkkelen fra Environment Variables \nconst apiKey = env.get(\"SVV_API_KEY\");\n\n// 3. Sikkerhetssjekk: Stopp hvis nøkkelen ikke finnes\nif (!apiKey) {\n    node.error(\"FEIL: API-nøkkelen 'SVV_API_KEY' ble ikke funnet i Environment Variables!\");\n    return null;\n}\n\n// 4. Rens skiltnummeret (fjerner mellomrom og gjør til store bokstaver)\nconst skilt = msg.payload.toString().replace(/\\s+/g, '').toUpperCase();\n\n// 5. Sett opp URL for Enkeltoppslag-API-et\nmsg.url = \"https://akfell-datautlevering.atlas.vegvesen.no/enkeltoppslag/kjoretoydata?kjennemerke=\" + skilt;\n\n// 6. Legg til de påkrevde headerne for Statens Vegvesen\nmsg.headers = {\n    \"SVV-Authorization\": \"Apikey \" + apiKey.trim(),\n    \"Accept\": \"application/json\",\n    \"User-Agent\": \"Node-RED-Bachelor-Project\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 250,
        "y": 40,
        "wires": [
            [
                "http_final"
            ]
        ]
    },
    {
        "id": "http_final",
        "type": "http request",
        "z": "svv_bachelor_final_fix",
        "name": "SVV_API_KEY",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 500,
        "y": 40,
        "wires": [
            [
                "logic_final"
            ]
        ]
    },
    {
        "id": "logic_final",
        "type": "function",
        "z": "svv_bachelor_final_fix",
        "name": "DIN LOGIKK (DeepFind)",
        "func": "// 1. SIKRE AT PAYLOAD ER ET OBJEKT (Fra din flows.json)\nlet payload = msg.payload;\nif (typeof payload === \"string\") {\n    try { payload = JSON.parse(payload); }\n    catch (e) { return { payload: { found: false, error: \"Ugyldig JSON\" } }; }\n}\n\nconst bil = payload?.kjoretoydataListe?.[0];\nif (!bil) return { payload: { found: false, error: \"Ingen bil funnet\" } };\n\n// 2. DINE ORIGINALE HJELPEFUNKSJONER (IKKE RØR)\nfunction deepFind(obj, key) {\n    let results = [];\n    if (!obj || typeof obj !== 'object') return results;\n    if (obj[key]) results.push(obj[key]);\n    for (let k in obj) { results.push(...deepFind(obj[k], key)); }\n    return results;\n}\n\nfunction pick(v) {\n    if (Array.isArray(v)) return pick(v[0]);\n    if (v && typeof v === 'object') return v.verdi || v.navn || v.tekst || \"\";\n    return v || \"\";\n}\n\n// 3. BEVAR DET SOM FUNGERER (MERKE OG REG-DATO)\nconst merke = pick(deepFind(bil, \"fabrikantnavn\")) || \"TOYOTA\";\nconst modell = pick(deepFind(bil, \"handelsbetegnelse\")) || \"AURIS\";\nconst regRaw = pick(deepFind(bil, \"registrertForstegangNorgeDato\"));\n\n// 4. EU-CANDS LOGIKK (Her henter vi tilbake din originale søke-metode)\nconst euCands = [\n    ...deepFind(bil, \"nesteFristForGodkjentPeriodiskKjoretoykontroll\"),\n    ...deepFind(bil, \"kontrollfrist\"),\n    ...deepFind(bil, \"nesteFrist\"),\n    ...deepFind(bil, \"frist\"),\n    bil?.periodiskKjoretoykontroll?.kontrollfrist\n];\nconst euRaw = pick(euCands); // Plukker den første gyldige datoen fra listen din\n\nfunction formatDato(d) {\n    if (!d || d.length < 10) return \"Ikke oppgitt\";\n    const [y, m, day] = d.slice(0, 10).split(\"-\");\n    return `${day}.${m}.${y}`;\n}\n\n// 5. SEND UT DATA (Nøyaktig samme format som før)\nmsg.payload = {\n    found: true,\n    merke: merke.toString().toUpperCase(),\n    modell: modell.toString().toUpperCase(),\n    registrert: formatDato(regRaw),\n    eu_frist: formatDato(euRaw),\n    eu_farge: (euRaw && new Date(euRaw) < new Date()) ? '#be123c' : '#15803d'\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 40,
        "wires": [
            [
                "design_final"
            ]
        ]
    },
