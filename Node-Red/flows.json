    {
        "id": "design_final",
        "type": "ui-template",
        "z": "svv_bachelor_final_fix",
        "group": "ui_group_final",
        "page": "",
        "ui": "",
        "name": "Design",
        "order": 2,
        "width": 6,
        "height": 4,
        "format": "<div style=\"font-family: Inter, Arial, sans-serif;\">\n\n  <div v-if=\"msg.payload && msg.payload.found\"\n       style=\"background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);\n              padding: 24px;\n              border-radius: 18px;\n              border: 1px solid #dbe7f3;\n              box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);\">\n\n    <div style=\"display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:18px;\">\n      <div>\n        <div style=\"font-size:12px; color:#64748b; font-weight:700; text-transform:uppercase; letter-spacing:1.1px; margin-bottom:6px;\">\n          Kjøretøyoppslag\n        </div>\n\n        <div style=\"font-size:34px; font-weight:900; color:#0f172a; line-height:1; margin-bottom:8px;\">\n          {{ msg.payload.merke }}\n          <span style=\"font-weight:400; color:#475569;\">{{ msg.payload.modell }}</span>\n        </div>\n\n        <div style=\"font-size:14px; color:#64748b;\">\n          Oppslag mot kjøretøydata\n        </div>\n      </div>\n\n      <div :style=\"{\n            background: msg.payload.eu_farge === '#be123c' ? '#fff1f2' : '#f0fdf4',\n            color: msg.payload.eu_farge === '#be123c' ? '#be123c' : '#15803d',\n            border: msg.payload.eu_farge === '#be123c' ? '1px solid #fecdd3' : '1px solid #bbf7d0',\n            padding: '10px 14px',\n            borderRadius: '999px',\n            fontSize: '13px',\n            fontWeight: '800',\n            whiteSpace: 'nowrap'\n          }\">\n        {{ msg.payload.eu_farge === '#be123c' ? 'EU utløpt / må sjekkes' : 'EU gyldig' }}\n      </div>\n    </div>\n\n    <div style=\"display:grid; grid-template-columns: 1fr 1fr; gap:14px; margin-bottom:14px;\">\n      <div style=\"background:#ffffff; padding:16px; border-radius:14px; border:1px solid #e2e8f0;\">\n        <div style=\"font-size:11px; color:#64748b; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:8px;\">\n          Første registrering i Norge\n        </div>\n        <div style=\"font-size:22px; font-weight:800; color:#0f172a;\">\n          {{ msg.payload.registrert }}\n        </div>\n      </div>\n\n      <div style=\"background:#ffffff; padding:16px; border-radius:14px; border:1px solid #e2e8f0;\">\n        <div style=\"font-size:11px; color:#64748b; font-weight:800; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:8px;\">\n          Neste EU-kontroll\n        </div>\n        <div :style=\"{\n              fontSize: '22px',\n              fontWeight: '800',\n              color: msg.payload.eu_farge || '#15803d'\n            }\">\n          {{ msg.payload.eu_frist }}\n        </div>\n      </div>\n    </div>\n\n    <div style=\"background:#eff6ff; border:1px solid #bfdbfe; color:#1d4ed8; padding:12px 14px; border-radius:12px; font-size:14px;\">\n      Resultatet er hentet og formatert fra backend-flyten i Node-RED.\n    </div>\n  </div>\n\n  <div v-else\n       style=\"background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);\n              border: 1px dashed #cbd5e1;\n              border-radius: 18px;\n              padding: 28px 22px;\n              text-align: center;\n              box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);\">\n\n    <div style=\"font-size:42px; margin-bottom:10px;\">🚗</div>\n\n    <div style=\"font-size:20px; font-weight:800; color:#0f172a; margin-bottom:8px;\">\n      Søk opp kjøretøy\n    </div>\n\n    <div style=\"font-size:14px; color:#64748b; max-width:420px; margin:0 auto 14px auto; line-height:1.5;\">\n      Skriv inn skiltnummer i feltet over for å hente informasjon om kjøretøyet.\n    </div>\n\n    <div v-if=\"msg.payload?.error\"\n         style=\"margin-top:12px; background:#fff1f2; color:#be123c; border:1px solid #fecdd3; padding:12px 14px; border-radius:12px; font-size:14px; font-weight:600;\">\n      {{ msg.payload.error }}\n    </div>\n  </div>\n\n</div>",
        "storeOutMessages": true,
        "passthru": true,
        "templateScope": "local",
        "className": "",
        "x": 980,
        "y": 40,
        "wires": [
            []
        ]
