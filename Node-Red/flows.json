        "id": "4c239bb28b9d1bdc",
        "type": "function",
        "z": "svv_bachelor_final_fix",
        "name": "function 3",
        "func": "let filename = String(msg.payload).trim();\n\n// fjern eventuelle ekstra anførselstegn fra exec-output\nfilename = filename.replace(/^\"+|\"+$/g, '');\n\nif (!filename) return null;\n\n// forventer f.eks. SU92254_1774373081.jpg\nconst match = filename.match(/^([A-Z]{2}\\d{5})_(\\d+)\\.jpg$/);\n\nif (!match) {\n    node.warn(\"Ugyldig filnavn: \" + filename);\n    return null;\n}\n\nconst plate = match[1];\nconst timestamp = match[2];\n\n// blokker bare hvis det er samme eksakte fil som sist\nconst lastProcessedFile = flow.get(\"lastProcessedFile\");\nif (lastProcessedFile === filename) {\n    return null;\n}\n\nflow.set(\"lastProcessedFile\", filename);\n\n// send videre til API\nmsg.payload = plate;\nmsg.filename = filename;\nmsg.scanTimestamp = timestamp;\n\nreturn msg;",
