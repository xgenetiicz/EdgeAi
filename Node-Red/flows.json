    {
        "id": "2696daaa63e7d6f7",
        "type": "function",
        "z": "svv_bachelor_final_fix",
        "name": "function 1",
        "func": "let reserved = flow.get(\"reservedPlates\") || [];\nlet plate = flow.get(\"inputPlate\");\n\nif (!plate) return null;\n\nplate = String(plate).replace(/\\s+/g, \"\").toUpperCase();\n\nreserved = reserved.map(item => {\n    let value = (item && typeof item === \"object\") ? item.plate : item;\n    return { plate: String(value).replace(/\\s+/g, \"\").toUpperCase() };\n});\n\nreserved = reserved.filter((item, index, arr) =>\n    arr.findIndex(x => x.plate === item.plate) === index\n);\n\nconst alreadyExists = reserved.some(item => item.plate === plate);\n\nif (!alreadyExists) {\n    reserved.push({ plate });\n}\n\nflow.set(\"reservedPlates\", reserved);\nflow.set(\"inputPlate\", \"\");\n\nreturn [\n    { payload: reserved },\n    { payload: alreadyExists ? `Skilt finnes allerede: ${plate}` : `Skilt lagt til: ${plate}` }\n];",
