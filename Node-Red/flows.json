    {
        "id": "f6f2886e4f2f81ad",
        "type": "function",
        "z": "svv_bachelor_final_fix",
        "name": "ListOfCars",
        "func": "// reservasjoner fra flow context\nconst reserved = flow.get(\"reservedPlates\") || [];\n\n// cache fra hovedflowen (her ligger merke/modell vi allerede har hentet fra SVV)\nconst vehicleCache = flow.get(\"vehicleCache\") || {};\n\n// gjør skiltnummer sammenlignbare\nfunction normalizePlate(plate) {\n    return String(plate || \"\").toUpperCase().replace(/\\s+/g, \"\");\n}\n\n// sjekk om bilen finnes i reservasjonslista\nfunction isReserved(plate, reservedList) {\n    const normalized = normalizePlate(plate);\n\n    return reservedList.some(item => {\n        if (typeof item === \"string\") {\n            return normalizePlate(item) === normalized;\n        }\n\n        if (item && typeof item === \"object\") {\n            return normalizePlate(item.plate) === normalized;\n        }\n\n        return false;\n    });\n}\n\n// exec-noden gir én streng med filnavn linje for linje\nconst lines = String(msg.payload || \"\")\n    .split(\"\\n\")\n    .map(x => x.trim())\n    .filter(Boolean);\n\n// bygg liste av biler fra filnavnene i /bilder/bil\nconst cars = lines\n    .map(file => {\n        // forventet format: SU92254_1774373081.jpg\n        const match = file.match(/^([A-Za-z0-9]+)_(\\d+)\\.(jpg|jpeg|png)$/i);\n        if (!match) return null;\n\n        const plate = normalizePlate(match[1]);\n        const timestamp = Number(match[2]);\n\n        // om bilen er reservert = adgang godkjent\n        const reservedMatch = isReserved(plate, reserved);\n\n        // hent evt. cachet merke/modell fra hovedflowen\n        const cached = vehicleCache[plate] || {};\n\n        return {\n            skilt: plate,\n            timestamp: timestamp,\n            klokkeslett: new Date(timestamp * 1000).toLocaleString(\"no-NO\"),\n            merke: cached.merke || \"Ukjent foreløpig\",\n            modell: cached.modell || \"\",\n            adgang_godkjent: reservedMatch,\n            adgang_tekst: reservedMatch ? \"Godkjent\" : \"Avslått\"\n        };\n    })\n    .filter(Boolean)\n    // nyeste øverst\n    .sort((a, b) => b.timestamp - a.timestamp);\n\n// send til ui-template\nmsg.payload = cars;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 280,
        "wires": [
            [
                "7f11b9d391487ab3"
            ]
        ]
    },
    {
        "id": "7f11b9d391487ab3",
        "type": "ui-template",
        "z": "svv_bachelor_final_fix",
        "group": "8b427c13f0eb4c8a",
        "page": "",
        "ui": "",
        "name": "Bilhistorikk template",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"car-list-wrap\">\n    <div v-if=\"msg.payload && msg.payload.length\" class=\"car-list\">\n      <div v-for=\"car in msg.payload\" :key=\"car.skilt + '-' + car.timestamp\" class=\"car-row\">\n        <div class=\"car-left\">\n          <div class=\"brand\">\n            {{ car.merke || \"Ukjent merke\" }}{{ car.modell ? ' ' + car.modell : '' }}\n          </div>\n        </div>\n\n        <div class=\"car-middle\">\n          <span :class=\"car.adgang_godkjent ? 'status-ok' : 'status-no'\">\n            {{ car.adgang_tekst }}\n          </span>\n        </div>\n\n        <div class=\"car-right\">\n          {{ car.klokkeslett }}\n        </div>\n      </div>\n    </div>\n\n    <div v-else class=\"empty-state\">\n      Ingen biler funnet\n    </div>\n  </div>\n</template>\n\n<style>\n.car-list-wrap {\n  height: 500px;\n  overflow-y: auto;\n  padding: 6px;\n  background: transparent;\n}\n\n.car-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.car-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 14px;\n  background: #ffffff;\n  border: 1px solid #dcdcdc;\n  border-radius: 10px;\n}\n\n.car-left {\n  flex: 1;\n  min-width: 180px;\n}\n\n.brand {\n  font-size: 15px;\n  font-weight: 700;\n  color: #222;\n}\n\n.car-middle {\n  min-width: 120px;\n  text-align: center;\n}\n\n.car-right {\n  min-width: 170px;\n  text-align: right;\n  font-size: 13px;\n  color: #555;\n}\n\n.status-ok,\n.status-no {\n  display: inline-block;\n  padding: 5px 10px;\n  border-radius: 999px;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.status-ok {\n  background: #dcfce7;\n  color: #166534;\n}\n\n.status-no {\n  background: #fee2e2;\n  color: #991b1b;\n}\n\n.empty-state {\n  padding: 20px;\n  text-align: center;\n  color: #666;\n}\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 700,
        "y": 280,
        "wires": [
